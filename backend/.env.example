# ============================================================
# AdaptEd AI - Backend Environment Configuration
# ============================================================

# DATABASE CONFIGURATION
# Local Development (SQLite):
DATABASE_URL=sqlite:///./adapted.db
# Cloud Production (Supabase PostgreSQL / Neon / Railway Postgres):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# AUTHENTICATION
JWT_SECRET=generate-a-strong-32-char-random-secret-here-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI ENGINES
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

GROQ_API_KEY=

# RAG & EMBEDDINGS
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DIR=../data/chroma
UPLOAD_DIR=../data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MAX_UPLOAD_MB=20
MAX_PAGES=80

# ADAPTIVE LEARNING ENGINE HYPERPARAMETERS
MASTERY_ALPHA_FIRST=0.50
MASTERY_ALPHA_REPEAT=0.30
PREREQ_UNLOCK_THRESHOLD=60
PREREQ_RELOCK_THRESHOLD=50
QUIZ_QUESTION_COUNT=5
DIAGNOSTIC_QUESTION_COUNT=10

# APPLICATION & CORS
APP_NAME=AdaptEd AI
# In production, set to your Vercel URL (comma-separated):
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=False
